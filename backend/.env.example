# Copy these into your environment (IntelliJ run configuration, shell, or a .env loader).
# Only DB_PASSWORD is required. Add whichever AI keys you have; each one you add becomes a provider.

DB_PASSWORD=your_mysql_password
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CORS_ORIGINS=http://localhost:5173

# First administrator (created or promoted on startup)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# AI providers - tried in this order, each skipped if its key is missing
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
UNOROUTER_API_KEY=         # https://unorouter.com
UNOROUTER_MODEL=           # a model your UnoRouter dashboard marks as free
HF_TOKEN=                  # https://huggingface.co/settings/tokens
COHERE_API_KEY=            # chat fallback + embeddings + rerank
GROQ_API_KEY=              # last-resort fallback

# Semantic mentor matching (optional; a local matcher is used if neither works)
FORGE_API_KEY=             # Voxell Forge "turbo" embeddings

# Optional extras
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RESEND_API_KEY=            # booking / milestone emails
